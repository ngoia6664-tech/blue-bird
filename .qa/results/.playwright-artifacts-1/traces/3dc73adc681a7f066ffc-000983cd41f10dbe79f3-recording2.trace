rk-form-grid { grid-template-columns: 1fr; gap: var(--space-4); padding: var(--space-4); }\n  .cover-col .cover { max-width: 180px; }\n  .field-row, .conflict-grid { grid-template-columns: 1fr; }\n  .title-fields { flex-direction: column; gap: 0; }\n  .chapter-label-input { width: 100% !important; min-height: 26px !important; font-size: var(--text-sm); }\n  .chapter-title-input { font-size: var(--text-md) !important; min-height: 32px !important; }\n  /* Full-width page on phones: the sheet frame would waste space. */\n  .editor-scroll { padding: 0 0 40vh; background: var(--color-surface); }\n  .editor-content .prose { border: none; border-radius: 0; box-shadow: none; padding: var(--space-5) var(--space-4); }\n  .hide-narrow { display: none; }\n  .save-state { max-width: 8rem; white-space: normal; text-align: center; }\n}\n"]],"\n  ",["BODY",{},"\n    ",["DIV",{"id":"root"},["DIV",{"class":"center-screen"},"Đang tải…"]],"\n    ","\n  \n\n"]],"viewport":{"width":1280,"height":720},"timestamp":29950.822,"wallTime":1793465389221,"collectionTime":0.699999988079071,"resourceOverrides":[],"isMainFrame":true}}
