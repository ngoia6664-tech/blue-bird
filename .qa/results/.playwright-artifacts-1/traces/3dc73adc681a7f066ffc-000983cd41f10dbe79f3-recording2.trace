nter-events: none;\n}\n.cover-placeholder::after {\n  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 10px;\n  background: linear-gradient(90deg, rgb(0 0 0 / 0.25), transparent); pointer-events: none;\n}\n.cover-placeholder svg { color: rgb(240 210 150 / 0.85); }\n.cover-placeholder span {\n  font-family: var(--font-prose); font-size: 1.125rem; font-weight: 600; line-height: 1.35;\n  display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere;\n  text-shadow: 0 1px 8px rgb(0 0 0 / 0.3);\n}\n\n/* ---------- Work form ---------- */\n.work-form { max-width: 960px; }\n.work-form-grid {\n  display: grid; grid-template-columns: 240px 1fr; gap: var(--space-6);\n  background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg);\n  padding: var(--space-6); box-shadow: var(--shadow-1); margin-bottom: var(--space-4);\n}\n.cover-col { display: flex; flex-direction: column; gap: var(--space-3); }\n.cover-col .cover { border-radius: var(--radius-md); box-shadow: var(--shadow-2); }\n.form-actions { display: flex; justify-content: flex-end; gap: var(--space-2); }\n\n/* ---------- Writer ---------- */\n.writer { height: 100%; display: flex; position: relative; }\n.sidebar, .side-panel {\n  flex: none; display: flex; flex-direction: column; gap: var(--space-3);\n  padding: var(--space-4) var(--space-3); background: var(--color-surface-glass);\n  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); overflow-y: auto;\n}\n.sidebar { width: var(--sidebar-w); border-right: 1px solid var(--color-border); }\n.side-panel { width: var(--panel-w); border-left: 1px solid var(--color-border); animation: slide-in-right var(--duration-slow) var(--ease); }\n.panel-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }\n.panel-head h2 { margin: 0; font-size: var(--text-md); }\n.work-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-prose); }\n.chapter-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }\n.chapter-list li { position: relative; display: flex; align-items: center; border-radius: var(--radius-md); transition: background var(--duration); }\n.chapter-list li:hover { background: rgb(34 31 26 / 0.04); }\n.chapter-list li.current { background: var(--color-accent-soft); }\n.chapter-list li.current::before {\n  content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px; border-radius: 3px; background: var(--gradient-accent);\n}\n.chapter-item {\n  flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start;\n  padding: var(--space-2) var(--space-3); border: none; background: none; text-align: left; cursor: pointer;\n}\n.chapter-label { font-size: var(--text-sm); font-weight: 600; }\n.chapter-title { font-size: var(--text-sm); color: var(--color-text-muted); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.current .chapter-label { color: var(--color-accent); }\n.trash-section { border-top: 1px solid var(--color-border); padding-top: var(--space-3); }\n\n.chapter-editor { flex: 1; min-width: 0; display: flex; flex-direction: column; }\n.editor-head {\n  display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-4);\n  background: var(--color-surface-glass); border-bottom: 1px solid var(--color-border);\n}\n.title-fields { flex: 1; min-width: 0; display: flex; gap: var(--space-2); }\n.title-fields input { border-color: transparent; background: transparent; min-height: 36px; box-shadow: none; }\n.title-fields input:hover { border-color: var(--color-border); }\n.chapter-label-input { width: 9rem !important; flex: none; font-weight: 600; color: var(--color-accent); }\n.chapter-title-input { font-family: var(--font-prose); font-size: var(--text-lg) !important; }\n.save-state {\n  font-size: var(--text-xs); font-weight: 500; white-space: nowrap; color: var(--color-text-muted);\n  padding: 3px var(--space-3); border-radius: var(--radius-pill); background: var(--color-surface-2);\n  transition: background var(--duration), color var(--duration);\n}\n.save-state.synced { color: var(--color-success); background: #e3f0e5; }\n.save-state.syncing, .save-state.saved-local { color: var(--color-warn); background: var(--color-glow-soft); }\n.save-state.error { color: var(--color-danger); background: #fdecea; }\n.toolbar {\n  display: flex; align-items: center; gap: 2px; padding: var(--space-1) var(--space-4);\n  background: var(--color-surface-glass); border-bottom: 1px solid var(--color-border); overflow-x: auto;\n}\n.tool {\n  width: 36px; height: 36px; flex: none; display: grid; place-items: center; border: none; border-radius: var(--radius-sm);\n  background: none; cursor: pointer; color: var(--color-text-muted); transition: background var(--duration), color var(--duration);\n}\n.tool:hover:not(:disabled) { background: var(--color-surface-2); color: var(--color-text); }\n.tool[aria-pressed='true'] { background: var(--color-accent-soft); color: var(--color-accent); }\n.tool-sep { width: 1px; height: 20px; background: var(--color-border); margin: 0 var(--space-1); flex: none; }\n/* The writing area is a calm paper sheet: no animation while typing. */\n.editor-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: var(--space-6) var(--space-4) 30vh; }\n.editor-content .prose {\n  max-width: calc(var(--prose-width) + 2 * var(--space-7)); margin: 0 auto; min-height: 60vh; outline: none;\n  padding: var(--space-7); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm);\n  box-shadow: var(--shadow-paper);\n  font-family: var(--font-prose); font-size: var(--prose-size); line-height: var(--prose-line); color: var(--color-text);\n  animation: fade var(--duration-slow) var(--ease);\n}\n.prose p { margin: 0 0 1em; }\