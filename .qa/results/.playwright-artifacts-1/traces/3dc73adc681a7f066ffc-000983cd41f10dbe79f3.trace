or-danger: #b3261e;\n  --color-warn: #8a5a00;\n  --color-success: #2e6b3a;\n  --color-focus: #2d6ae0;\n\n  --gradient-accent: linear-gradient(135deg, var(--color-accent) 0%, var(--color-accent-2) 100%);\n  --gradient-ambient:\n    radial-gradient(60rem 40rem at 100% -10%, rgb(224 168 74 / 0.16), transparent 60%),\n    radial-gradient(50rem 36rem at -10% 110%, rgb(74 111 196 / 0.13), transparent 60%);\n\n  --font-ui: 'Be Vietnam Pro', system-ui, 'Segoe UI', Roboto, sans-serif;\n  /* Literata ships with the app: full Vietnamese glyphs (Georgia lacks stacked marks like ố, ộ). */\n  --font-prose: 'Literata Variable', 'Times New Roman', serif;\n  --text-xs: 0.75rem;\n  --text-sm: 0.875rem;\n  --text-md: 1rem;\n  --text-lg: 1.25rem;\n  --text-xl: 1.75rem;\n  --prose-size: 1.125rem;\n  --prose-line: 1.85;\n  --prose-width: 40rem;\n\n  --space-1: 0.25rem;\n  --space-2: 0.5rem;\n  --space-3: 0.75rem;\n  --space-4: 1rem;\n  --space-5: 1.5rem;\n  --space-6: 2rem;\n  --space-7: 3rem;\n\n  --radius-sm: 6px;\n  --radius-md: 10px;\n  --radius-lg: 16px;\n  --radius-pill: 999px;\n\n  --shadow-1: 0 1px 2px rgb(34 31 26 / 0.05), 0 2px 6px rgb(34 31 26 / 0.05);\n  --shadow-2: 0 10px 30px -10px rgb(34 31 26 / 0.22), 0 4px 10px -4px rgb(34 31 26 / 0.08);\n  --shadow-glow: 0 6px 20px -6px rgb(45 74 138 / 0.55);\n  --shadow-paper: 0 1px 3px rgb(34 31 26 / 0.06), 0 12px 40px -18px rgb(34 31 26 / 0.18);\n\n  --topbar-h: 56px;\n  --sidebar-w: 280px;\n  --panel-w: 300px;\n  --duration: 160ms;\n  --duration-slow: 360ms;\n  --ease: cubic-bezier(0.2, 0.7, 0.2, 1);\n}\n\n@media (prefers-reduced-motion: reduce) {\n  :root {\n    --duration: 0ms;\n    --duration-slow: 0ms;\n  }\n}\n"],["STYLE",{},"*, *::before, *::after { box-sizing: border-box; }\nhtml, body, #root { height: 100%; }\nbody {\n  margin: 0;\n  font-family: var(--font-ui);\n  font-size: var(--text-md);\n  line-height: 1.5;\n  color: var(--color-text);\n  background: var(--gradient-ambient), var(--color-bg);\n  background-attachment: fixed;\n  -webkit-font-smoothing: antialiased;\n}\nh1, h2, h3 { line-height: 1.3; margin: 0 0 var(--space-3); letter-spacing: -0.01em; }\nh1 { font-size: var(--text-xl); font-family: var(--font-prose); font-weight: 600; }\nh2 { font-size: var(--text-lg); font-weight: 600; }\nh3 { font-size: var(--text-md); font-weight: 600; }\np { margin: 0 0 var(--space-3); }\na { color: var(--color-accent); }\ninput, select, textarea, button { font: inherit; color: inherit; }\n:focus-visible { outline: 2px solid var(--color-focus); outline-offset: 2px; }\n::selection { background: var(--color-glow-soft); }\n\n.muted { color: var(--color-text-muted); }\n.small { font-size: var(--text-sm); }\n.error { color: var(--color-danger); }\n.row { display: flex; gap: var(--space-2); flex-wrap: wrap; }\n.spacer { flex: 1; }\n\n/* ---------- Motion ---------- */\n@keyframes rise { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: none; } }\n@keyframes fade { from { opacity: 0; } to { opacity: 1; } }\n@keyframes pulse { 0%, 100% { box-shadow: 0 0 0 0 rgb(224 168 74 / 0.6); } 50% { box-shadow: 0 0 0 5px rgb(224 168 74 / 0); } }\n@keyframes slide-in-left { from { transform: translateX(-24px); opacity: 0; } to { transform: none; opacity: 1; } }\n@keyframes slide-in-right { from { transform: translateX(24px); opacity: 0; } to { transform: none; opacity: 1; } }\n@media (prefers-reduced-motion: reduce) {\n  *, *::before, *::after { animation: none !important; transition: none !important; }\n}\n\n/* ---------- Controls ---------- */\n.btn {\n  display: inline-flex; align-items: center; justify-content: center; gap: var(--space-2);\n  min-height: 40px; padding: 0 var(--space-4);\n  border: 1px solid var(--color-border); border-radius: var(--radius-md);\n  background: var(--color-surface); font-weight: 500; text-decoration: none; cursor: pointer;\n  box-shadow: var(--shadow-1);\n  transition: background var(--duration), border-color var(--duration), box-shadow var(--duration), transform var(--duration) var(--ease);\n}\n.btn:hover { border-color: var(--color-border-strong); background: var(--color-surface-2); }\n.btn:active { transform: translateY(1px) scale(0.99); }\n.btn.primary {\n  position: relative; overflow: hidden;\n  background: var(--gradient-accent); border-color: transparent; color: var(--color-accent-contrast);\n  box-shadow: var(--shadow-glow);\n}\n/* Soft light sweep on hover. */\n.btn.primary::after {\n  content: ''; position: absolute; inset: 0;\n  background: linear-gradient(110deg, transparent 30%, rgb(255 255 255 / 0.28) 50%, transparent 70%);\n  transform: translateX(-100%); transition: transform var(--duration-slow) var(--ease);\n}\n.btn.primary:hover { background: var(--gradient-accent); box-shadow: 0 10px 26px -8px rgb(45 74 138 / 0.65); transform: translateY(-1px); }\n.btn.primary:hover::after { transform: translateX(100%); }\n.btn.small { min-height: 32px; padding: 0 var(--space-3); font-size: var(--text-sm); }\n.btn:disabled, .tool:disabled { opacity: 0.5; cursor: not-allowed; transform: none; }\n\n.icon-btn {\n  display: inline-flex; align-items: center; justify-content: center;\n  width: 36px; height: 36px; flex: none;\n  border: none; border-radius: var(--radius-md); background: transparent; color: var(--color-text);\n  cursor: pointer; transition: background var(--duration), color var(--duration);\n}\n.icon-btn:hover { background: var(--color-surface-2); color: var(--color-accent); }\n.icon-btn[aria-disabled='true'] { opacity: 0.35; cursor: default; background: none; color: inherit; }\n.link-btn {\n  display: inline-flex; align-items: center; gap: var(--space-1);\n  border: none; background: none; padding: 0; color: var(--color-accent); cursor: pointer; font-weight: 500;\n}\n.link-btn:hover { text-decoration: underline; }\n\ninput:not([type='file']), select, textarea {\n  width: 100%; min-height: 40px; padding: var(--space-2) var(--space-3);\n  border: 1px solid var(--color-border); border-radius: var(--radius-md); background: var(--color-surface);\n  transition: border-color var(--duration), box-shadow var(--duration);\n}\ninput:not([type='file']):hover, select:hover, textarea:hover { border-color: var(--color-border-strong); }\ninput:not([type='file']):focus, select:focus, textarea:focus {\n  outline: none; border-color: var(--color-accent-2); box-shadow: 0 0 0 3px var(--color-accent-soft);\n}\ntextarea { resize: vertical; line-height: 1.6; }\ninput[aria-invalid='true'], textarea[aria-invalid='true'] { border-color: var(--color-danger); }\n.field { display: flex; flex-direction: column; gap: var(--space-1); margin-bottom: var(--space-4); }\n.field > span { font-size: var(--text-sm); font-weight: 500; color: var(--color-text-muted); }\n.field-row { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); }\n.search { position: relative; display: flex; align-items: center; }\n.search svg { position: absolute; left: var(--space-3); color: var(--color-text-muted); pointer-events: none; }\n.search input { padding-left: 2.25rem; }\n\n.badge { padding: 2px var(--space-2); border-radius: var(--radius-pill); font-size: var(--text-xs); font-weight: 500; background: var(--color-surface-2); color: var(--color-text-muted); }\n.badge.status-writing { background: var(--color-accent-soft); color: var(--color-accent); }\n.badge.status-paused { background: var(--color-glow-soft); color: var(--color-warn); }\n.badge.status-done { background: #e3f0e5; color: var(--color-success); }\n\n.card {\n  background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg);\n  padding: var(--space-5); margin-bottom: var(--space-4); box-shadow: var(--shadow-1);\n}\n.card.narrow { max-width: 420px; width: 100%; text-align: center; }\n/* First screen paints instantly: no entrance animation, so it can never be stuck invisible. */\n.center-screen { min-height: 100%; display: grid; place-items: center; padding: var(--space-4); }\n.login {\n  background: var(--color-surface-glass); backdrop-filter: blur(16px); -webkit-backdrop-filter: blur(16px);\n  box-shadow: var(--shadow-2); padding: var(--space-7) var(--space-6);\n}\n.login h1 { font-size: 2rem; margin-top: var(--space-2); }\n.login .btn { width: 100%; margin-top: var(--space-4); min-height: 46px; }\n.logo {\n  display: inline-grid; place-items: center; width: 34px; height: 34px; border-radius: var(--radius-md);\n  background: var(--gradient-accent); color: var(--color-accent-contrast);\n  box-shadow: 0 4px 12px -4px rgb(45 74 138 / 0.6), inset 0 0 0 1px rgb(255 255 255 / 0.15);\n}\n.logo.big { width: 64px; height: 64px; border-radius: var(--radius-lg); }\n\n.menu { position: relative; }\n.menu-list {\n  position: absolute; right: 0; top: calc(100% + 4px); z-index: 30; min-width: 200px;\n  display: flex; flex-direction: column; padding: var(--space-1);\n  background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); box-shadow: var(--shadow-2);\n  transform-origin: top right; animation: rise var(--duration) var(--ease);\n}\n.menu-list button { display: flex; align-items: center; gap: var(--space-2); white-space: nowrap; text-align: left; padding: var(--space-2) var(--space-3); border: none; background: none; border-radius: var(--radius-sm); cursor: pointer; }\n.menu-list button svg { flex: none; color: var(--color-text-muted); }\n.menu-list button.danger svg { color: inherit; }\n.menu-list button:hover:not(:disabled), .menu-list button:focus-visible { background: var(--color-surface-2); }\n.menu-list button.danger { color: var(--color-danger); }\n.menu-list button:disabled { opacity: 0.4; cursor: default; }\n\n/* Icon + text messages and headings line up on one baseline. */\n.with-icon { display: flex; align-items: center; gap: var(--space-2); }\n.with-icon svg { color: var(--color-glow); flex: none; }\n.notice svg { flex: none; vertical-align: -3px; margin-right: var(--space-1); }\n.notice { margin: 0; padding: var(--space-2) var(--space-4); background: var(--color-glow-soft); color: var(--color-warn); font-size: var(--text-sm); animation: fade var(--duration) var(--ease); }\n.notice.error { background: #fdecea; color: var(--color-danger); }\n\n/* ---------- App shell ---------- */\n.app { height: 100%; display: flex; flex-direction: column; }\n.topbar {\n  position: relative; z-index: 40;\n  height: var(--topbar-h); flex: none; display: flex; align-items: center; gap: var(--space-3);\n  padding: 0 var(--space-5);\n  background: var(--color-surface-glass); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px);\n  border-bottom: 1px solid var(--color-border);\n}\n.brand { display: flex; align-items: center; gap: var(--space-2); color: inherit; text-decoration: none; }\n.brand-name { font-family: var(--font-prose); font-weight: 600; font-size: 1.125rem; letter-spacing: -0.01em; }\n.tabs { display: flex; gap: var(--space-1); margin-left: var(--space-5); padding: 3px; border-radius: var(--radius-pill); background: rgb(34 31 26 / 0.04); }\n.tabs a {\n  display: flex; align-items: center; gap: var(--space-2); padding: 6px var(--space-4);\n  border-radius: var(--radius-pill); color: var(--color-text-muted); text-decoration: none; font-weight: 500; font-size: var(--text-sm);\n  transition: background var(--duration), color var(--duration), box-shadow var(--duration);\n}\n.tabs a:hover { color: var(--color-text); }\n.tabs a.active { color: var(--color-accent); background: var(--color-surface); box-shadow: var(--shadow-1); }\n.sync-badge {\n  margin-left: auto; display: flex; align-items: center; gap: var(--space-2);\n  padding: 4px var(--space-3); border-radius: var(--radius-pill); background: rgb(255 255 255 / 0.6); border: 1px solid var(--color-border);\n  font-size: var(--text-sm); color: var(--color-text-muted);\n}\n.sync-badge .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--color-success); box-shadow: 0 0 0 3px rgb(46 107 58 / 0.15); }\n.sync-badge.warn .dot, .sync-badge.busy .dot { background: var(--color-glow); animation: pulse 1.6s ease-in-out infinite; }\n.sync-badge.error .dot { background: var(--color-danger); box-shadow: 0 0 0 3px rgb(179 38 30 / 0.15); }\n.sync-badge.error { color: var(--color-danger); }\n.avatar {\n  width: 34px; height: 34px; border-radius: 50%; overflow: hidden; display: grid; place-items: center;\n  background: var(--color-glow-soft); color: var(--color-warn); font-weight: 600; text-decoration: none; flex: none;\n  box-shadow: 0 0 0 2px var(--color-surface), 0 0 0 3px var(--color-border);\n  transition: box-shadow var(--duration);\n}\n.avatar:hover { box-shadow: 0 0 0 2px var(--color-surface), 0 0 0 4px var(--color-glow); }\n.avatar img { width: 100%; height: 100%; object-fit: cover; }\n.main { flex: 1; min-height: 0; overflow: auto; }\n.page { max-width: 1200px; margin: 0 auto; padding: var(--space-6) var(--space-5); animation: rise var(--duration-slow) var(--ease); }\n.empty { text-align: center; padding: var(--space-7) var(--space-4); }\n\n/* ---------- Library ---------- */\n.library-hero { display: flex; align-items: flex-end; justify-content: space-between; gap: var(--space-4); flex-wrap: wrap; margin-bottom: var(--space-5); }\n.library-hero h1 { margin: 0; font-size: 2rem; }\n.hero-stats { display: flex; gap: var(--space-2); flex-wrap: wrap; }\n.stat-chip {\n  display: flex; flex-direction: column; padding: var(--space-2) var(--space-4); min-width: 7rem;\n  background: var(--color-surface-glass); border: 1px solid var(--color-border); border-radius: var(--radius-md);\n}\n.stat-chip b { font-family: var(--font-prose); font-size: var(--text-lg); font-weight: 600; color: var(--color-accent); }\n.stat-chip span { font-size: var(--text-xs); color: var(--color-text-muted); }\n.library-top { display: grid; grid-template-columns: 2fr 1fr; gap: var(--space-4); margin-bottom: var(--space-7); }\n.library-top > * { min-width: 0; }\n.recent, .quick-actions {\n  background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg);\n  padding: var(--space-5); box-shadow: var(--shadow-1);\n}\n.recent h2, .quick-actions h2 { font-size: var(--text-md); margin-bottom: var(--space-3); }\n.quick-actions { display: flex; flex-direction: column; gap: var(--space-2); background: linear-gradient(160deg, var(--color-surface) 40%, var(--color-glow-soft)); }\n.recent-list { list-style: none; margin: 0; padding: 0; }\n.recent-item {\n  display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-3);\n  border-radius: var(--radius-md); color: inherit; text-decoration: none; transition: background var(--duration), transform var(--duration) var(--ease);\n}\n.recent-item svg { color: var(--color-glow); flex: none; }\n.recent-item:hover { background: var(--color-surface-2); transform: translateX(3px); }\n.recent-title { flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 500; }\n.section-head { display: flex; align-items: center; justify-content: space-between; }\n.filters { display: grid; grid-template-columns: 1fr auto auto; gap: var(--space-2); margin-bottom: var(--space-5); }\n.filters select { width: auto; }\n.work-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); gap: var(--space-5); }\n.work-card {\n  display: flex; flex-direction: column; background: var(--color-surface);\n  border: 1px solid var(--color-border); border-radius: var(--radius-lg); overflow: visible;\n  box-shadow: var(--shadow-1);\n  animation: rise var(--duration-slow) var(--ease) both; animation-delay: min(calc(var(--i, 0) * 45ms), 450ms);\n  transition: transform var(--duration-slow) var(--ease), box-shadow var(--duration-slow) var(--ease), border-color var(--duration);\n}\n.work-card:hover, .work-card:focus-within { transform: translateY(-4px); box-shadow: var(--shadow-2); border-color: var(--color-border-strong); }\n.work-cover-link { display: block; overflow: hidden; text-decoration: none; border-radius: var(--radius-lg) var(--radius-lg) 0 0; }\n.work-cover-link .cover { transition: transform var(--duration-slow) var(--ease); }\n.work-card:hover .work-cover-link .cover { transform: scale(1.04); }\n.work-info { padding: var(--space-3) var(--space-4) var(--space-4); display: flex; flex-direction: column; gap: var(--space-1); }\n.work-info p { margin: 0; }\n.work-info .btn { align-self: flex-start; margin-top: var(--space-2); }\n.work-title-row { display: flex; align-items: flex-start; gap: var(--space-1); }\n.work-title {\n  flex: 1; margin: 0; font-family: var(--font-prose); font-size: 1.0625rem;\n  display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;\n}\n.work-meta { display: flex; flex-wrap: wrap; gap: var(--space-2); align-items: center; font-size: var(--text-sm); color: var(--color-text-muted); }\n\n/* Book cover: placeholder is a generated two-tone cover tinted by --hue (set per work). */\n.cover { aspect-ratio: 2 / 3; width: 100%; background: var(--color-surface-2); overflow: hidden; }\n.cover img { width: 100%; height: 100%; object-fit: cover; display: block; }\n.cover-placeholder {\n  position: relative; height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center;\n  gap: var(--space-3); padding: var(--space-5) var(--space-4); text-align: center; color: rgb(255 255 255 / 0.95);\n  background:\n    radial-gradient(120% 70% at 50% 0%, hsl(var(--hue) 70% 70% / 0.35), transparent 60%),\n    linear-gradient(165deg, hsl(var(--hue) 42% 36%), hsl(calc(var(--hue) + 35) 48% 17%));\n}\n/* Thin gold frame and spine shadow, like a printed cover. */\n.cover-placeholder::before {\n  content: ''; position: absolute; inset: 10px; border: 1px solid rgb(240 210 150 / 0.45); border-radius: 3px; pointer-events: none;\n}\n.cover-placeholder::after {\n  content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 10px;\n  background: linear-gradient(90deg, rgb(0 0 0 / 0.25), transparent); pointer-events: none;\n}\n.cover-placeholder svg { color: rgb(240 210 150 / 0.85); }\n.cover-placeholder span {\n  font-family: var(--font-prose); font-size: 1.125rem; font-weight: 600; line-height: 1.35;\n  display: -webkit-box; -webkit-line-clamp: 4; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: anywhere;\n  text-shadow: 0 1px 8px rgb(0 0 0 / 0.3);\n}\n\n/* ---------- Work form ---------- */\n.work-form { max-width: 960px; }\n.work-form-grid {\n  display: grid; grid-template-columns: 240px 1fr; gap: var(--space-6);\n  background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg);\n  padding: var(--space-6); box-shadow: var(--shadow-1); margin-bottom: var(--space-4);\n}\n.cover-col { display: flex; flex-direction: column; gap: var(--space-3); }\n.cover-col .cover { border-radius: var(--radius-md); box-shadow: var(--shadow-2); }\n.form-actions { display: flex; justify-content: flex-end; gap: var(--space-2); }\n\n/* ---------- Writer ---------- */\n.writer { height: 100%; display: flex; position: relative; }\n.sidebar, .side-panel {\n  flex: none; display: flex; flex-direction: column; gap: var(--space-3);\n  padding: var(--space-4) var(--space-3); background: var(--color-surface-glass);\n  backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); overflow-y: auto;\n}\n.sidebar { width: var(--sidebar-w); border-right: 1px solid var(--color-border); }\n.side-panel { width: var(--panel-w); border-left: 1px solid var(--color-border); animation: slide-in-right var(--duration-slow) var(--ease); }\n.panel-head { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }\n.panel-head h2 { margin: 0; font-size: var(--text-md); }\n.work-name { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-family: var(--font-prose); }\n.chapter-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }\n.chapter-list li { position: relative; display: flex; align-items: center; border-radius: var(--radius-md); transition: background var(--duration); }\n.chapter-list li:hover { background: rgb(34 31 26 / 0.04); }\n.chapter-list li.current { background: var(--color-accent-soft); }\n.chapter-list li.current::before {\n  content: ''; position: absolute; left: 0; top: 8px; bottom: 8px; width: 3px; border-radius: 3px; background: var(--gradient-accent);\n}\n.chapter-item {\n  flex: 1; min-width: 0; display: flex; flex-direction: column; align-items: flex-start;\n  padding: var(--space-2) var(--space-3); border: none; background: none; text-align: left; cursor: pointer;\n}\n.chapter-label { font-size: var(--text-sm); font-weight: 600; }\n.chapter-title { font-size: var(--text-sm); color: var(--color-text-muted); max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.current .chapter-label { color: var(--color-accent); }\n.trash-section { border-top: 1px solid var(--color-border); padding-top: var(--space-3); }\n\n.chapter-editor { flex: 1; min-width: 0; display: flex; flex-direction: column; }\n.editor-head {\n  display: flex; align-items: center; gap: var(--space-2); padding: var(--space-2) var(--space-4);\n  background: var(--color-surface-glass); border-bottom: 1px solid var(--color-border);\n}\n.title-fields { flex: 1; min-width: 0; display: flex; gap: var(--space-2); }\n.title-fields input { border-color: transparent; background: transparent; min-height: 36px; box-shadow: none; }\n.title-fields input:hover { border-color: var(--color-border); }\n.chapter-label-input { width: 9rem !important; flex: none; font-weight: 600; color: var(--color-accent); }\n.chapter-title-input { font-family: var(--font-prose); font-size: var(--text-lg) !important; }\n.save-state {\n  font-size: var(--text-xs); font-weight: 500; white-space: nowrap; color: var(--color-text-muted);\n  padding: 3px var(--space-3); border-radius: var(--radius-pill); background: var(--color-surface-2);\n  transition: background var(--duration), color var(--duration);\n}\n.save-state.synced { color: var(--color-success); background: #e3f0e5; }\n.save-state.syncing, .save-state.saved-local { color: var(--color-warn); background: var(--color-glow-soft); }\n.save-state.error { color: var(--color-danger); background: #fdecea; }\n.toolbar {\n  display: flex; align-items: center; gap: 2px; padding: var(--space-1) var(--space-4);\n  background: var(--color-surface-glass); border-bottom: 1px solid var(--color-border); overflow-x: auto;\n}\n.tool {\n  width: 36px; height: 36px; flex: none; display: grid; place-items: center; border: none; border-radius: var(--radius-sm);\n  background: none; cursor: pointer; color: var(--color-text-muted); transition: background var(--duration), color var(--duration);\n}\n.tool:hover:not(:disabled) { background: var(--color-surface-2); color: var(--color-text); }\n.tool[aria-pressed='true'] { background: var(--color-accent-soft); color: var(--color-accent); }\n.tool-sep { width: 1px; height: 20px; background: var(--color-border); margin: 0 var(--space-1); flex: none; }\n/* The writing area is a calm paper sheet: no animation while typing. */\n.editor-scroll { flex: 1; min-height: 0; overflow-y: auto; padding: var(--space-6) var(--space-4) 30vh; }\n.editor-content .prose {\n  max-width: calc(var(--prose-width) + 2 * var(--space-7)); margin: 0 auto; min-height: 60vh; outline: none;\n  padding: var(--space-7); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-sm);\n  box-shadow: var(--shadow-paper);\n  font-family: var(--font-prose); font-size: var(--prose-size); line-height: var(--prose-line); color: var(--color-text);\n  animation: fade var(--duration-slow) var(--ease);\n}\n.prose p { margin: 0 0 1em; }\n.prose h2, .prose h3 { margin: 1.5em 0 0.5em; }\n.prose blockquote { margin: 1.2em 0; padding: 0.2em 0 0.2em 1.2em; border-left: 3px solid var(--color-glow); color: var(--color-text-muted); font-style: italic; }\n.editor-content.preview .prose {\n  font-size: var(--text-sm); min-height: 0; max-height: 50vh; overflow-y: auto; padding: var(--space-4); box-shadow: none; animation: none;\n}\n.editor-foot {\n  display: flex; align-items: center; gap: var(--space-4); padding: var(--space-1) var(--space-4);\n  background: var(--color-surface-glass); border-top: 1px solid var(--color-border); font-size: var(--text-sm); color: var(--color-text-muted);\n}\n\n.stats { display: grid; grid-template-columns: auto 1fr; gap: var(--space-2) var(--space-3); margin: 0; font-size: var(--text-sm); padding: var(--space-3); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-md); }\n.stats dt { color: var(--color-text-muted); white-space: nowrap; }\n.stats dd { margin: 0; text-align: right; font-weight: 500; }\n.version-list { list-style: none; margin: 0; padding: 0; }\n.version-list button {\n  width: 100%; display: flex; flex-direction: column; align-items: flex-start; padding: var(--space-2) var(--space-3);\n  border: none; background: none; border-radius: var(--radius-md); cursor: pointer; text-align: left; transition: background var(--duration);\n}\n.version-list button:hover { background: var(--color-surface-2); }\n.version-preview { display: flex; flex-direction: column; gap: var(--space-3); }\n\n.conflict { overflow-y: auto; }\n.conflict-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-4); }\n.conflict-grid section { display: flex; flex-direction: column; gap: var(--space-2); padding: var(--space-4); background: var(--color-surface); border: 1px solid var(--color-border); border-radius: var(--radius-lg); box-shadow: var(--shadow-1); }\n.conflict-text { white-space: pre-wrap; font-family: var(--font-prose); max-height: 50vh; overflow-y: auto; margin: 0; padding: var(--space-3); background: var(--color-surface-2); border-radius: var(--radius-md); }\n\n.settings { max-width: 640px; }\n.small-screen-only { display: none; }\n.scrim { display: none; }\n\n/* ---------- Narrow screens: one column, drawers on demand ---------- */\n@media (max-width: 999px) {\n  .sidebar, .side-panel {\n    position: absolute; top: 0; bottom: 0; z-index: 20; box-shadow: var(--shadow-2); width: min(86vw, 340px);\n    background: var(--color-surface);\n  }\n  .sidebar { left: 0; animation: slide-in-left var(--duration-slow) var(--ease); }\n  .side-panel { right: 0; }\n  .scrim { display: block; position: absolute; inset: 0; z-index: 10; background: rgb(34 31 26 / 0.35); animation: fade var(--duration) var(--ease); }\n  .editor-content .prose { padding: var(--space-6) var(--space-5); }\n}\n\n@media (max-width: 720px) {\n  .topbar { gap: var(--space-2); padding: 0 var(--space-3); }\n  .brand-name { display: none; }\n  /* Visually hidden but still the accessible name of icon-only tabs and the sync badge. */\n  .tabs a span, .sync-text { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }\n  .tabs { margin-left: var(--space-1); }\n  .tabs a { padding: 8px var(--space-3); }\n  .sync-badge { padding: 8px; }\n  .page { padding: var(--space-4) var(--space-3); }\n  .library-hero h1 { font-size: 1.5rem; }\n  .hero-stats { width: 100%; }\n  .stat-chip { min-width: 0; flex: 1; }\n  .recent-item .small { display: none; }\n  .library-top { grid-template-columns: 1fr; margin-bottom: var(--space-5); }\n  .quick-actions { display: none; }\n  .small-screen-only { display: inline-flex; }\n  .filters { grid-template-columns: 1fr 1fr; }\n  .filters .search { grid-column: 1 / -1; }\n  .filters select { width: 100%; }\n  .work-grid { grid-template-columns: repeat(auto-fill, minmax(145px, 1fr)); gap: var(--space-3); }\n  .work-info { padding: var(--space-3); }\n  .work-form-grid { grid-template-columns: 1fr; gap: var(--space-4); padding: var(--space-4); }\n  